{
  "name": "project-submission-dashboar-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
     "start": "node api/server.js",
    "build": "prisma generate && tsup src/server.ts --format esm --platform node --target node20 --outDir api --external pg-native",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "push": "prisma db push",
    "pull": "prisma db pull",
    "stripe:webhook": "stripe listen --forward-to localhost:5000/webhook",
    "stripe:trigger": "stripe trigger payment_intent.succeeded",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
